      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"ecommerce-.*\"}[5m])) by (name)",
          "legendFormat": "{{name}} CPU",
          "refId": "A"
        }
      ],
      "title": "Per-Container CPU Core Consumption",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "container_memory_usage_bytes{name=~\"ecommerce-.*\"}",
          "legendFormat": "{{name}} Memory",
          "refId": "A"
        }
      ],
      "title": "Per-Container RAM Consumption",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
